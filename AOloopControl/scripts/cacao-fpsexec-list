#!/bin/bash
# cacao-fpsexec-list
# List all installed cacao-fpsexec-* commands with
# their one-line descriptions (via -h1 flag).

SKIP_LIST="cacao-fpsexec-list"

SEARCH_TERM="${1:-}"

if [ "$SEARCH_TERM" = "-h" ] || [ "$SEARCH_TERM" = "--help" ]; then
    echo "Usage: cacao-fpsexec-list [SEARCH_TERM]"
    echo ""
    echo "List all installed cacao-fpsexec-* standalone executables"
    echo "with their one-line descriptions."
    echo ""
    echo "These executables are compute units that can run independently"
    echo "or be managed by the FPS (Function Parameter Synchronization) system."
    echo ""
    echo "Arguments:"
    echo "  SEARCH_TERM    Optional. Filter the list of executables to only show"
    echo "                 those whose name or description matches this term."
    echo "                 The search supports Extended Regular Expressions (regex)"
    echo "                 and is case-insensitive."
    echo "                 If omitted, all executables are listed."
    echo ""
    echo "Examples:"
    echo "  cacao-fpsexec-list             # List all cacao fpsexec executables"
    echo "  cacao-fpsexec-list filter      # List executables containing 'filter'"
    echo "  cacao-fpsexec-list \"filter|cm\" # List executables containing 'filter' or 'cm'"
    echo "  cacao-fpsexec-list \"^cacao\"    # List executables starting with 'cacao'"
    echo "  cacao-fpsexec-list -h          # Print this help message"
    exit 0
fi

col_name=45

printf "\033[1;34m%-${col_name}s %s\033[0m\n" \
    "COMMAND" "DESCRIPTION"
printf "%-${col_name}s %s\n" \
    "$(printf '%0.s-' $(seq 1 $col_name))" \
    "$(printf '%0.s-' $(seq 1 40))"

for cmd in $(compgen -c cacao-fpsexec- | sort -u); do
    # Skip utility commands
    skip=0
    for s in $SKIP_LIST; do
        if [ "$cmd" = "$s" ]; then
            skip=1
            break
        fi
    done
    [ $skip -eq 1 ] && continue

    desc=$("$cmd" -h1 2>/dev/null)
    rc=$?
    if [ $rc -eq 0 ] && [ -n "$desc" ]; then
        line=$(printf "%-${col_name}s %s" "$cmd" "$desc")
    else
        line=$(printf "%-${col_name}s %s" "$cmd" "(no description)")
    fi

    if [ -n "$SEARCH_TERM" ]; then
        if ! echo "$line" | grep -E -qi -e "$SEARCH_TERM"; then
            continue
        fi
    fi
    echo "$line"
done
