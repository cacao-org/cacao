#!/usr/bin/env bash

MSdescr="Take dark from stream"

MSextdescr="Take dark, copy it to AOcalib/wfsdark dir"

source milk-script-std-config


RequiredCommands=( cacao-cli milk-shmimave milk-fps-set milk-fps-rm milk-fpsexec-iofits-saveFITS milk-FITS2shm )
RequiredFiles=(LOOPNUMBER)
RequiredDirs=(AOcalibs/wfsdark)

MSarg+=( "nbframe:int:number of frames to be averaged" )

MSopt+=( "a:shma:setshmapply::Apply to shared memory" )



shmapply="0"
function setshmapply() {
	echo "Applying dark to shm"
	shmapply="1"
}


source milk-argparse

set +u
if [ "${EXITSTATUS}" = "1" ]; then
exit
fi
set -u









nbframe="${inputMSargARRAY[0]}"

echo "Number of frame : ${nbframe}"





if [ -f LOOPNUMBER ]; then
    AOLOOPNUMBER=$( head -1 LOOPNUMBER )
else
	echo "Error: no LOOPNUMBER file. Are we running this from the correct directory ?"
    exit
fi


# Arguments:
# Calib name



ARCHDIR="AOcalibs/dark"

echo "Loop ${AOLOOPNUMBER}"


_avefps="takedark_$$"
_darkshm="imdark_$$"
milk-shmimave "${_avefps}:fpsinit" "aol${AOLOOPNUMBER}_wfsim" "${_darkshm}" "${nbframe}"
milk-fps-set "${_avefps}.procinfo.triggersname" "aol${AOLOOPNUMBER}_wfsim"
milk-fps-set "${_avefps}.procinfo.triggermode" 3
milk-fps-set "${_avefps}.procinfo.loopcntMax" "${nbframe}"
milk-shmimave "${_avefps}:run"
milk-fps-rm -f -x "${_avefps}"
milk-fpsexec-iofits-saveFITS _savefits:exec "${_darkshm}" "!imdark.fits"
rm -f "${MILK_SHM_DIR}/${_darkshm}.im.shm"

mkdir -p ${ARCHDIR}
cp imdark.fits ${ARCHDIR}/dark_$(date -u --iso-8601=seconds).fits

if [ "${shmapply}" = "1" ]; then
milk-FITS2shm _loadfits:exec "imdark.fits" "@S:aol${AOLOOPNUMBER}_wfsdark"
fi
