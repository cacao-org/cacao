#!/usr/bin/env bash


MSdescr="Archive current AO calibration"

MSextdescr="Copy current filesystem calibration to AOcalibs/<calibname>/ directory"

source milk-script-std-config

# check and load cacaovars
source cacao-check-cacaovars


RequiredCommands=( cacao-cli )
RequiredPipes=()
RequiredFiles=()
RequiredDirs=(AOcalibs)


MSarg+=( "calibname:string:calibration name" )

source milk-argparse

set +u
if [ "${EXITSTATUS}" = "1" ]; then
	exit 1
fi
set -u




calib="${inputMSargARRAY[0]}"
echo "Calibration : ${calib}"



# Arguments:
# Calib name


ARCHDIR="AOcalibs/${calib}"

mkdir -p ${ARCHDIR}


MILK_QUIET=1 cacao-cli << EOF
mem.readshmim aol${CACAO_LOOPNUMBER}_modesWFS
iofits.saveFITS aol${CACAO_LOOPNUMBER}_modesWFS "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_modesWFS.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_DMmodes
iofits.saveFITS aol${CACAO_LOOPNUMBER}_DMmodes "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_DMmodes.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_wfsref
iofits.saveFITS aol${CACAO_LOOPNUMBER}_wfsref "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_wfsref.fits"


mem.readshmim aol${CACAO_LOOPNUMBER}_wfsmask
iofits.saveFITS aol${CACAO_LOOPNUMBER}_wfsmask "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_wfsmask.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_wfsmap
iofits.saveFITS aol${CACAO_LOOPNUMBER}_wfsmap "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_wfsmap.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_dmmask
iofits.saveFITS aol${CACAO_LOOPNUMBER}_dmmask "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_dmmask.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_dmslaved
iofits.saveFITS aol${CACAO_LOOPNUMBER}_dmslaved "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_dmslaved.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_zrespM
iofits.saveFITS aol${CACAO_LOOPNUMBER}_zrespM "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_zrespM.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_LOrespM
iofits.saveFITS aol${CACAO_LOOPNUMBER}_LOrespM "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_LOrespM.fits"

mem.readshmim aol${CACAO_LOOPNUMBER}_LODMmodes
iofits.saveFITS aol${CACAO_LOOPNUMBER}_LODMmodes "!${ARCHDIR}/aol${CACAO_LOOPNUMBER}_LODMmodes.fits"

exit
EOF




echo "$(date -u --iso-8601=seconds) ARCHCURRENT ${calib}" >> AOcalibs/AOcalib-${CACAO_LOOPNUMBER}-log.txt

cacaomsglog "END"
