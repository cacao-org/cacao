#!/usr/bin/env bash


MSdescr="Set WFS reference to flat"

MSextdescr="
This should only apply to WFSs aiming to achieve flat illumination over wfsmask,
such as the pyramid WFS.
"


source milk-script-std-config
source cacao-check-cacaovars
RequiredCommands=( cacao-cli )


source milk-argparse



cacaomsglog "START"


sendFPScmd "setval acquWFS-${CACAO_LOOPNUMBER}.comp.WFSrefc OFF"
sendFPScmd "confupdate acquWFS-${CACAO_LOOPNUMBER}"

cacao-cli << EOF
iofits.loadfits "conf/wfsmask.fits" wfsmask .
@calc "wfsm = wfsmask * 1.0; wfsmn = wfsm / itot(wfsm)"
mem.readshmim aol${CACAO_LOOPNUMBER}_wfsrefc
mem.imcpshm wfsmn aol${CACAO_LOOPNUMBER}_wfsrefc
iofits.saveFITS wfsmn "!wfsmn.fits"
exit
EOF

cacaomsglog "END"
