#!/usr/bin/env bash

sname="iiwi"
NBframe=8000
limfact="4.0"

_avefps="rmbadpix_$$"
_avestream="imave_$$"
_rmsstream="imrms_$$"

milk-shmimave "${_avefps}:fpsinit" "${sname}" "${_avestream}" "${NBframe}"
milk-fps-set "${_avefps}.procinfo.triggersname" "${sname}"
milk-fps-set "${_avefps}.procinfo.triggermode" 1
milk-fps-set "${_avefps}.procinfo.loopcntMax" "${NBframe}"
milk-fps-set "${_avefps}.comp.rms" ON
milk-fps-set "${_avefps}.outrms_name" "${_rmsstream}"
milk-shmimave "${_avefps}:run"
milk-fps-rm -f -x "${_avefps}"

cacao-cli << EOF
mem.readshmim ${_rmsstream}
iofits.saveFITS ${_rmsstream} "!imrms.fits"
@calc "limv = perc(s.${_rmsstream}, 0.5) * ${limfact}; imrms2 = clamp(s.${_rmsstream} / limv, 0.0, 1.1); mask = 1.0 - floor(imrms2)"
iofits.saveFITS mask "!pixmask.fits"
mem.readshmim aol7_wfsmask
mem.imcpshm mask aol7_wfsmask
exit
EOF

rm -f "${MILK_SHM_DIR}/${_avestream}.im.shm" "${MILK_SHM_DIR}/${_rmsstream}.im.shm"
