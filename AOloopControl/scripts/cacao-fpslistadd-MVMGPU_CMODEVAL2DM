#!/usr/bin/env bash

FPSKWname="CACAO_FPSPROC_MVMGPU_CMODEVAL2DM"

FPSKWval="NULL"
if [ ! -z "${CACAO_FPSPROC_MVMGPU_CMODEVAL2DM+x}" ]; then
	FPSKWval="$CACAO_FPSPROC_MVMGPU_CMODEVAL2DM"
fi


# FPS name
fpsname="mvalC2dm"
fpsarg0="${CACAO_LOOPNUMBER}"

# FPS full name
fpsfname="${fpsname}-${fpsarg0}"

# function call
fpsfcall="milk-fpsexec-linalg-MVMextract"

# short description
fpsdescr="Mode coefficients to DM"




function fpsentry_addmodules() {
	echo "+milklinalgebra" >> fpslist.txt
}


function fpsentry_addcmds() {
	addfpscmd "setval ${fpsfname}.procinfo.loopcntMax -1"
	addfpscmd "setval ${fpsfname}.procinfo.triggermode 3"
	addfpscmd "setval ${fpsfname}.procinfo.triggersname aol${CACAO_LOOPNUMBER}_modevalDM"

	addfpscmd "setval ${fpsfname}.insname aol${CACAO_LOOPNUMBER}_modevalDM"
	addfpscmd "setval ${fpsfname}.inmasksname aol${CACAO_LOOPNUMBER}_dmmask"
	addfpscmd "setval ${fpsfname}.immodes aol${CACAO_LOOPNUMBER}_CMmodesDM"
	addfpscmd "setval ${fpsfname}.outcoeff aol${CACAO_LOOPNUMBER}_dmC"



	addfpscmd "setval ${fpsfname}.GPUindex 0"

	addfpscmd "setval ${fpsfname}.axmode 1"
	addfpscmd "setval ${fpsfname}.option.MODENORM OFF"

}



source cacao-fpslist-addentry
