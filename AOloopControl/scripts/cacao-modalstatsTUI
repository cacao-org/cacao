#!/usr/bin/env bash

MSdescr="AO modal stats TUI"

MSextdescr="Displays modal stats in an interactive ANSI terminal UI
"

source milk-script-std-config

# check and load cacaovars
source cacao-check-cacaovars
RequiredCommands=( cacao-modalstatsTUI-bin )
RequiredPipes=()
RequiredFiles=()
RequiredDirs=()

source milk-argparse

set +u
if [ "${EXITSTATUS}" = "1" ]; then
	exit 1
fi
set -u

exec cacao-modalstatsTUI-bin "${CACAO_LOOPNUMBER}"
