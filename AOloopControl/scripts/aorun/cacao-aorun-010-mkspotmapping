#!/usr/bin/env bash

# This script uses milk-argparse
# See template milk-scriptexample in module milk_module_example for template and instructions

# script 1-line description
MSdescr="Make spots mapping"



source cacaovars.*.bash

# Extended description
MSextdescr="Make spots mapping

CACAO_LOOPNAME = ${CACAO_LOOPNAME}
"

source milk-script-std-config
source cacao-check-cacaovars


RequiredCommands=( tmux cacao-cli milk-shmimave milk-fps-set milk-fps-rm milk-FITS2shm )

RequiredPipes=()

RequiredDirs=()


# parse arguments
source milk-argparse






echo "input frame = ${CACAO_WFSSTREAM}"

_avefps="mkspotmap_$$"
_avestream="${CACAO_WFSSTREAM}_ave"
milk-shmimave "${_avefps}:fpsinit" "${CACAO_WFSSTREAM}" "${_avestream}" 1000
milk-fps-set "${_avefps}.procinfo.triggersname" "${CACAO_WFSSTREAM}"
milk-fps-set "${_avefps}.procinfo.triggermode" 3
milk-fps-set "${_avefps}.procinfo.loopcntMax" 1000
milk-shmimave "${_avefps}:run"
milk-fps-rm -f -x "${_avefps}"

cacao-cli << EOF
mem.readshmim ${_avestream}
iofits.loadfits "${CACAO_WFSSTREAM}_dark.fits" imdark .
@calc "imflux = s.${_avestream} - imdark"
iofits.saveFITS imflux "!${CACAO_WFSSTREAM}_wfsref.fits"
cacaoio.findspots imflux 4 20 19 mapc
iofits.saveFITS spotscan "!spotscan.fits"
iofits.saveFITS mapc "!${CACAO_WFSSTREAM}_mapc.fits"
exit
EOF

milk-FITS2shm _loadfits:exec "${CACAO_WFSSTREAM}_mapc.fits" "@S:${CACAO_WFSSTREAM}_mapc"

sendFPScmd "setval mapWFS-${CACAO_LOOPNUMBER}.wfsin ${CACAO_WFSSTREAM}"
sendFPScmd "setval mapWFS-${CACAO_LOOPNUMBER}.map ${CACAO_WFSSTREAM}_mapc"

sendFPScmd "setval mapWFS-${CACAO_LOOPNUMBER}.procinfo.triggersname ${CACAO_WFSSTREAM}"

rm -f $MILK_SHM_DIR/aol${CACAO_LOOPNUMBER}_wfsim.im.shm
sendFPScmd "setval mapWFS-${CACAO_LOOPNUMBER}.wfsout aol${CACAO_LOOPNUMBER}_wfsim"
