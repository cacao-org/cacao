#!/usr/bin/env bash

# Examples:
# cacao-aorun-040-compfCM -g 0 -c 10 -sm 0.01 -se 0.01 -m 12 -ef 1.1 -eo 0.3 -t
# cacao-aorun-040-compfCM -g 0 -zrm "./nlcWFS/zrespM-H.fits" -wfsm "./nlcWFS/wfsmask.fits" -dmm "./nlcWFS/dmmask.fits" -tm "./nlcWFS/FpokesC.8.fits" -t


# This script uses milk-argparse
# See template milk-scriptexample in module milk_module_example for template and instructions

# temp directory for intermediate steps
cfCMtmpdir="compfCM"

# script 1-line description
MSdescr="Build control modes ordered according to spatial frequency"

DMmask="./conf/dmmask.fits"
WFSmask="./conf/wfsmask.fits"
zrespm="./conf/RMmodesWFS/zrespM-H.fits"

MSextdescr="Takes as input the zonal response matrix
Uses temporary directory ./${cfCMtmpdir}/

INPUT TARGET CONTROL MODES (Tmodes)
The output control modes will try to adhere to the Tmodes, using the same
ordering.
By default Cmdoes are Zernike modes followed by Fourier modes.
User can specify a custom set of input control modes with -cm option.

DM EXTRAPOLATION
DM extrapolation set by extrfactor and extroffset.
Extrapolation extends beyond dmmask by extroffset pixel (fixed quantity for all
modes) and extrfactor radian.(proportional to Fourier mode period). The second
extrapolation (radian) is tapered.

Input files read by script :
	$DMmask   (override with -dmm)
	$WFSmask  (override with -wfsm)
	$zrespm   (override with -zrm)

Output Files, spatially sorted (sf) control matrix files:

	conf/CMmodesDM/CMmodesDM_sf.fits
	conf/CMmodesDM/CMmodesDM_sfe.fits  (spatially extended)
	conf/CMmodesWFS/CMmodesWFS_sf.fits
"

source milk-script-std-config
source cacao-check-cacaovars

RequiredCommands+=( cacao-cli )


TESTMODE=0
MSopt+=( "t:testmode:setTESTMODE::permorms tests" )
function setTESTMODE()
{
	TESTMODE=1
}


# amplification factor for TT
TTfactor="8.0"
MSopt+=( "ttf:ttf:setTTfactor:TTfactor[float]:Tip-Tilt amplification factor [${TTfactor}]" )
function setTTfactor()
{
	TTfactor=$1
}


# Fourier power law
# large value -> fast decrease of amplitude with spatial frequency
Falpha="1.0"
MSopt+=( "fa:Falpha:setFalpha:Falpha[float]:Set power law index [0.5]" )
function setFalpha()
{
	Falpha=$1
}



MSopt+=( "zrm:zrespm:setzrespm:zrespm[string]:zonal response matrix [${zrespm}]" )
function setzrespm()
{
	zrespm=$1
}

MSopt+=( "wfsm:WFSmask:setWFSmask:WFSmask[string]:WFS mask [${WFSmask}]" )
function setWFSmask()
{
	WFSmask=$1
}

MSopt+=( "dmm:DMmask:setDMmask:DMmask[string]:DM mask [${DMmask}]" )
function setDMmask()
{
	DMmask=$1
}

# target control modes (input) to be used
# These are the target modes we will try to adhere to
#
Tmodes="NULL"
MSopt+=( "tm:Tmodes:setTmodes:Tmodes[string]:Target control modes DM input, recreate if NULL [${Tmodes}]" )
function setTmodes()
{
	Tmodes=$1
}





extrfactor="1.0"
MSopt+=( "ef:extrfactor:setextfactor:extrfactor[float]:DM extrapolation factor [${extrfactor}]" )
function setextfactor()
{
	extrfactor=$1
}

extroffset="0.5"
MSopt+=( "eo:extroffset:setextoffset:extroffset[float]:DM extrapolation offset in pix [${extroffset}]" )
function setextoffset()
{
	extroffset=$1
}



GPUdevice="-1"
MSopt+=( "g:GPUdevice:setGPUdevice:GPUdevice[int]:Set GPU device, -1 for CPU [${GPUdevice}]" )
function setGPUdevice()
{
	GPUdevice=$1
}

CPAmax="8"
MSopt+=( "c:CPAmax:setCPAmax:cpamax[float]:max cycles per aperture (CPA)[${CPAmax}]" )
function setCPAmax()
{
	CPAmax=$1
}

maxemode=16
MSopt+=( "m:maxemode:setmaxemode:maxemode[int]:number of modes for DM extrapolation[${maxemode}]" )
function setmaxemode()
{
	maxemode=$1
}

NBzer=5
MSopt+=( "z:NBzer:setNBzer:NBzer[int]:Set number of Zernike polynomials [${NBzer}]" )
function setNBzer()
{
	NBzer=$1
}

SVDlim="0.1"
MSopt+=( "sm:SVDlim:setSVDlim:SVDlim[float]:Set SVD limit for pseudoinverse [${SVDlim}]" )
function setSVDlim()
{
	SVDlim=$1
}


SVDelim="0.1"
MSopt+=( "se:SVDelim:setSVDelim:SVDelim[float]:Set SVD extrapolation limit [${SVDelim}]" )
function setSVDelim()
{
	SVDelim=$1
}


source milk-argparse

# Re-order control modes in increasing spatial frequency by multidimentional rotation


# Input
#
# by convention:
# CMmodesWFS is orthogonal over wfsmask
# CMmodesDM is norm2 normalized over dmmask
#
#maxSVDmode=80
#CMmDM="conf/CMmodesDM/CMmodesDM.fits[*,*,1:${maxSVDmode}]"
#CMmWFS="conf/CMmodesWFS/CMmodesWFS.fits[*,*,1:${maxSVDmode}]"



echo "extrfactor = ${extrfactor}"
echo "extroffset = ${extroffset}"

mkdir -p ${cfCMtmpdir}



# Get DM size from DMmask

echo "Checking DM size from file $DMmask"

DMsizex=$(cacao-cli -q -c "iofits.loadfits \"${DMmask}\" dmm .; @get l.dmm.xsize; exit" | awk 'NF{v=$1} END{print v}')
echo "DMsizex = $DMsizex"

DMsizey=$(cacao-cli -q -c "iofits.loadfits \"${DMmask}\" dmm .; @get l.dmm.ysize; exit" | awk 'NF{v=$1} END{print v}')
echo "DMsizey = $DMsizey"












if [ "$Tmodes" = "NULL" ]; then

########################################################################
#
# CONSTRUCT TARGET MODES IN DM SPACE
# -> TmodesDMn: normalized over dmmask
# -> TmodesDM : not normalized
#
# This is 5 Zernikes (TTF+Ast) + Fourier modes
########################################################################

# Create set of Fourier modes, store as modesF.fits
#
#CACAO_DMxsize=12
#CACAO_DMysize=12
#CACAO_DM_beam_rad=5.5
x0default=$(echo "scale=3; $CACAO_DMxsize/2-0.5" | bc)
y0default=$(echo "scale=3; $CACAO_DMysize/2-0.5" | bc)
r0default=$(echo "scale=3; 0.450*$CACAO_DMxsize" | bc)


# 2D defaults
DMsizex=${CACAO_DMxsize}
DMsizey=${CACAO_DMysize}
DMx0=${CACAO_DM_beam_xcent:-$x0default}
DMy0=${CACAO_DM_beam_ycent:-$y0default}
#DMr0=${CACAO_DM_beam_rad:-$r0t}
DMr0=${CACAO_DM_beam_rad:-$r0default}


echo "DMx0 = $DMx0"
echo "DMy0 = $DMy0"
echo "DMr0 = $DMr0"



# Create DM-space modes ordered by spatial frequency
# First modes are Zernikes, then Fourier
# Modes are not orthogonal
#
# This is the target ordering which the new control modes should
# match as well as possible
#
# output :
# TmodesDMn.fits :  Modes, normalized over dmmask
#

# amplification factor for TT
TTfactor="8.0"

# Fourier power law
# large value -> fast decrease of amplitude with spatial frequency
Falpha="0.0"

cacao-cli << EOF
zern.mkzerc modesZ ${DMsizex} ${DMsizey} ${DMx0} ${DMy0} ${DMr0} ${NBzer} .TTfactor=${TTfactor} .radmaskfact=1.1
iofits.saveFITS modesZ "!./${cfCMtmpdir}/modesZ.fits"
iofits.loadfits "${DMmask}" dmmask .
lintools.mkFouriermodes modesF ${DMsizex} ${DMsizey} ${CPAmax} 0.8 ${DMr0} 1.2 0 .fpowerlaw=-${Falpha} .fpowerlaw_minf=1.0 .fpowerlaw_maxf=100.0 .align.centered=0 .align.xcenter=${DMx0} .align.ycenter=${DMy0} .rCPAmin=0.1 .maskim=dmmask .extrfactor=${extrfactor} .extroffset=${extroffset}
iofits.saveFITS modesF "!./${cfCMtmpdir}/modesF.fits"
arith.immerge modesZ modesF modesZF 2
iofits.saveFITS modesZF "!./${cfCMtmpdir}/TmodesDM.fits"
@calc 'mm = modesZF * dmmask; n2 = einsum("ijk,ijk->k", mm, mm); invn = reshape(n2 > 0 ? 1.0 / sqrt(n2) : 0.0, 1, 1, l.modesZF.zsize); TmodesDMn = modesZF * invn'
iofits.saveFITS TmodesDMn "!./${cfCMtmpdir}/TmodesDMn.fits"
exit
EOF

else
pwd
cp ${Tmodes} "./${cfCMtmpdir}/TmodesDM.fits"

cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/TmodesDM.fits" TmodesDM .
iofits.loadfits "${DMmask}" dmmask .
@calc 'mm = TmodesDM * dmmask; n2 = einsum("ijk,ijk->k", mm, mm); invn = reshape(n2 > 0 ? 1.0 / sqrt(n2) : 0.0, 1, 1, l.TmodesDM.zsize); TmodesDMn = TmodesDM * invn'
iofits.saveFITS TmodesDMn "!./${cfCMtmpdir}/TmodesDMn.fits"
exit
EOF

fi






########################################################################
#
# EXTRAPOLATION MODES
#
# Used to extrapolate DM shape beyond active pixels
# A modal basis is constructed, along with its extended (beyond
# active DM pixels) version.
#
########################################################################

#
# Build modal decomposition for spatial extrapolation in DM space
#
# Perform PCA of TmodesDMn.fits by SVD
#
# INPUT:
#   TmodesDMn.fits (target modes, normalized)
#
# OUTPUT:
#   emodesDM.fits
#   emodesDMe.fits
#


cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/TmodesDMn.fits[*,*,1:${maxemode}]" TmodesDMn .
iofits.loadfits "${DMmask}" dmmask .
@calc "TmodesDMnm = TmodesDMn * dmmask"
linalg.compSVD TmodesDMnm TmodesDMnmU TmodesDMnmS TmodesDMnmV ${SVDelim} .GPUdevice=${GPUdevice}
iofits.saveFITS TmodesDMnmU "!./${cfCMtmpdir}/emodesDM.fits"
linalg.SVDmkU TmodesDMn TmodesDMnmV TmodesDMnmS emodesDMe out1US .GPUdevice=${GPUdevice}
iofits.saveFITS emodesDMe "!./${cfCMtmpdir}/emodesDMe.fits"
exit
EOF




if [ ${TESTMODE} = 1 ]; then
# OPTIONAL
# Check orthogonality in DM space
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/emodesDM.fits" emodesDM .
linalg.sgemm emodesDM emodesDM out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/emodesDM_xp.fits"
exit
EOF
fi



########################################################################
#
# MODAL RM
#
########################################################################



# Compute WFS response to TmodesDMn over wfsmask -> TmodesDMnWFSm.fits
#
cacao-cli << EOF
iofits.loadfits "${zrespm}" zrespM .
iofits.loadfits "./${cfCMtmpdir}/TmodesDMn.fits" TmodesDMn .
iofits.loadfits "${WFSmask}" wfsmask .
linalg.sgemm zrespM TmodesDMn TmodesDMnWFS .GPUdevice=${GPUdevice}
iofits.saveFITS TmodesDMnWFS "!./${cfCMtmpdir}/TmodesDMnWFS.fits"
@calc "TmodesDMnWFSm = TmodesDMnWFS * wfsmask"
iofits.saveFITS TmodesDMnWFSm "!./${cfCMtmpdir}/TmodesDMnWFSm.fits"
exit
EOF




# Compute WFS response to TmodesDM over wfsmask -> TmodesWFSm.fits
#
# INPUT:
#   zrespm
#   modesZF.fits
#
# OUTPUT:
#   modesZFWFS.fits
#   modesZFWFSm.fits
#

cacao-cli << EOF
iofits.loadfits "${zrespm}" zrespM .
iofits.loadfits "./${cfCMtmpdir}/TmodesDM.fits" TmodesDM .
linalg.sgemm zrespM TmodesDM TmodesWFS .GPUdevice=${GPUdevice}
iofits.saveFITS TmodesWFS "!./${cfCMtmpdir}/TmodesWFS.fits"
iofits.loadfits "${WFSmask}" wfsmask .
@calc "TmodesWFSm = TmodesWFS * wfsmask"
iofits.saveFITS TmodesWFSm "!./${cfCMtmpdir}/TmodesWFSm.fits"
exit
EOF




########################################################################
#
# CONTROL MODES
#
# Straight SVD of zrespM
#
########################################################################


if [ ${TESTMODE} = 1 ]; then
# COMPUTE CONTROL MODES FROM Z-RESPM
#

# Perform PCA of zespM.fits by SVD
#
# The output is ordered by singular value
# This is not a friendly ordering, spatial frequency is not preserved
# The first modes are NOT low-order mores :(
#
# OUTPUT:
# zCMmDM.fits
# zCMmWFS.fits
#


cacao-cli << EOF
iofits.loadfits "${zrespm}" zespM .
iofits.loadfits "${WFSmask}" wfsmask .
@calc "zespMm = zespM * wfsmask"
linalg.compSVD zespMm mFsvdU mFsvdS mFsvdV ${SVDlim} .GPUdevice=${GPUdevice} .Vdim0=${DMsizex}
iofits.saveFITS SVDunmodes "!./${cfCMtmpdir}/zCMmWFS.fits"
iofits.loadfits "${DMmask}" dmmask .
@calc "mFsvdVm = mFsvdV * dmmask"
iofits.saveFITS mFsvdVm "!./${cfCMtmpdir}/zCMmDM.fits"
exit
EOF
fi







# COMPUTE CONTROL MODES FROM RESPONSE TO ZF MODES (includes power law alpha)
#
# INPOUT:
#   TmodesDM.fits
#   TmodesWFSm.fits
#
# OUTPUT:
#   CMmDM.fits
#   CMmWFS.fits
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/TmodesDM.fits" RMDM .
iofits.loadfits "./${cfCMtmpdir}/TmodesWFSm.fits" RMWFS .
linalg.compSVD RMWFS mFsvdU mFsvdS mFsvdV ${SVDlim} .GPUdevice=${GPUdevice}
iofits.saveFITS SVDunmodes "!./${cfCMtmpdir}/CMmWFS.fits"
linalg.sgemm RMDM mFsvdV outDM .GPUdevice=${GPUdevice} .transpA=0 .transpB=0
iofits.saveFITS outDM "!./${cfCMtmpdir}/CMmDM.fits"
exit
EOF



if [ ${TESTMODE} = 1 ]; then
# Reconstruct WFS from DM (TEST)

cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmDMn.fits" CMmDM .
iofits.loadfits "${zrespm}" zespM .
linalg.sgemm zespM CMmDM out .GPUdevice=${GPUdevice}
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDM_WFS.fits"
exit
EOF
fi





# Renormalize modes in WFS space
#
# Input:
#   CMmDM   : control modes in DM space, unity RMS over dmmask
#   CMmWFS  : control modes in WFS space, orthogonal basis
#
# Output:
#   CMmDMn  : control modes in DM space
#   CMmWFSn : control modes in WFS space, orthonormal basis over wfsmask
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmDM.fits" CMmDM .
iofits.loadfits "./${cfCMtmpdir}/CMmWFS.fits" CMmWFS .
iofits.loadfits "${WFSmask}" wfsmask .
@calc 'mm = CMmWFS * wfsmask; n2 = einsum("ijk,ijk->k", mm, mm); invn = reshape(n2 > 0 ? 1.0 / sqrt(n2) : 0.0, 1, 1, l.CMmWFS.zsize); CMmWFSn = CMmWFS * invn; CMmDM = CMmDM * invn; CMmWFSnm = CMmWFSn * wfsmask'
iofits.saveFITS CMmWFSnm "!./${cfCMtmpdir}/CMmWFSn.fits"
iofits.saveFITS CMmDM "!./${cfCMtmpdir}/CMmDMn.fits"
exit
EOF



if [ ${TESTMODE} = 1 ]; then

# Check orthonormality in WFS space (input)
#
cacao-cli << EOF
iofits.loadfits "${WFSmask}" wfsmask .
iofits.loadfits "./${cfCMtmpdir}/CMmWFS.fits" CMmWFS .
@calc "CMmWFSm = CMmWFS * wfsmask"
linalg.sgemm CMmWFSm CMmWFSm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmWFS_mxp.fits"
exit
EOF

# Check orthonormality in DM space (input)
#
cacao-cli << EOF
iofits.loadfits "${DMmask}" dmmask .
iofits.loadfits "./${cfCMtmpdir}/CMmDM.fits" CMmDM .
@calc "CMmDMm = CMmDM * dmmask"
linalg.sgemm CMmDMm CMmDMm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDM_mxp.fits"
exit
EOF


# Check orthonormality in WFS space (output)
#
cacao-cli << EOF
iofits.loadfits "${WFSmask}" wfsmask .
iofits.loadfits "./${cfCMtmpdir}/CMmWFSn.fits" CMmWFSn .
@calc "CMmWFSnm = CMmWFSn * wfsmask"
linalg.sgemm CMmWFSnm CMmWFSnm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmWFSn_mxp.fits"
exit
EOF


# Check orthonormality in DM space (output)
#
cacao-cli << EOF
iofits.loadfits "${DMmask}" dmmask .
iofits.loadfits "./${cfCMtmpdir}/CMmDMn.fits" CMmDMn .
@calc "CMmDMnm = CMmDMn * dmmask"
linalg.sgemm CMmDMnm CMmDMnm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDMn_mxp.fits"
exit
EOF

# Reconstruct WFS from DM (TEST)

cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmDMn.fits" CMmDMn .
iofits.loadfits "${zrespm}" zespM .
linalg.sgemm zespM CMmDMn out .GPUdevice=${GPUdevice}
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDMn_WFS.fits"
exit
EOF
fi









########################################################################
#
# CONTROL MODES x TARGET MODES XP
#
########################################################################


# WFS-space Gramm-Schmidt
#
# INPUT:
#   TmodesDMnWFSm: WFS response to normalized DM ZF modes
#
# OUTPUT:
#   TmodesDMnWFSmwfsgs
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/TmodesDMnWFSm.fits" TmodesDMnWFSm .
iofits.loadfits "./${cfCMtmpdir}/TmodesDMn.fits" TmodesDMn .
linalg.GramSchmidt TmodesDMnWFSm TmodesDMnWFSmgs .GPUdevice=${GPUdevice} .auxmat=TmodesDMn
iofits.saveFITS TmodesDMn "!./${cfCMtmpdir}/TmodesDMnwfsgs.fits"
iofits.saveFITS TmodesDMnWFSmgs "!./${cfCMtmpdir}/TmodesDMnWFSmwfsgs.fits"
exit
EOF



# Decompose TmodesDMnWFSmwfsgs.fits against CMmWFSn over wfsmask
# The result is stored in TmodesDMnWFSmwfsgs_CMmWFSnm_xp.fits.
# The decomposition is a SGEMM over wfsmask because CMmWFSn is orthonormal over wfsmask
#
# INPUT:
#   CMmWFSn              : input basis
#   TmodesDMnWFSmwfsgs    : target basis, WFS-space, post-GS
#
# OUTPUT:
#   TmodesDMnWFSm_CMmWFSnm_xp
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmWFSn.fits" CMmWFSn .
iofits.loadfits "${WFSmask}" wfsmask .
@calc "CMmWFSnm = CMmWFSn * wfsmask"
iofits.loadfits "./${cfCMtmpdir}/TmodesDMnWFSmwfsgs.fits" TmodesDMnWFSmwfsgs .
linalg.sgemm TmodesDMnWFSmwfsgs CMmWFSnm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/TmodesDMnWFSmwfsgs_CMmWFSnm_xp.fits"
exit
EOF






# Compute the rotation that will turn
# the cross-product into a lower(0,1)/upper(2) triangular matrix, ensuring
# a good match between the two sets of modes.
# The rotation is stored as matArot.fits
# We then apply the rotation to CMmDM and CMmWFS
#
#
# INPUT:
#   TmodesDMnWFSm_CMmWFSnm_xp
#
# OUTPUT:
#   matABr    : rotated decomposition of control modes (y axis) against target modes (x axis)
#   matArot   : rotation matrix applied
#   CMmDMnr   : rotated (new) basis, DM space
#   CMmWFSnr  : rotated (new) basis, WFS space
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/TmodesDMnWFSmwfsgs_CMmWFSnm_xp.fits" matAB .
linalg.basisrotmatch matAB matArot .optmode=1
# matABr.fits should now be lower triangular
iofits.saveFITS matAB "!./${cfCMtmpdir}/matABr.fits"
iofits.saveFITS matArot "!./${cfCMtmpdir}/matArot.fits"
#
# Apply rotation to CMmDMn
iofits.loadfits "./${cfCMtmpdir}/CMmDMn.fits" CMmDMn .
linalg.sgemm CMmDMn matArot CMmDMnr .GPUdevice=${GPUdevice} .transpA=0 .transpB=0
iofits.saveFITS CMmDMnr "!./${cfCMtmpdir}/CMmDMnr.fits"
#
# Apply rotation to CMmWFSn
iofits.loadfits "./${cfCMtmpdir}/CMmWFSn.fits" CMmWFSn .
linalg.sgemm CMmWFSn matArot CMmWFSnr .GPUdevice=${GPUdevice} .transpA=0 .transpB=0
iofits.saveFITS CMmWFSnr "!./${cfCMtmpdir}/CMmWFSnr.fits"
#
exit
EOF



if [ ${TESTMODE} = 1 ]; then
# CHECK

cacao-cli << EOF
iofits.loadfits "${zrespm}" zrespM .
iofits.loadfits "./${cfCMtmpdir}/TmodesDMnwfsgs.fits" TmodesDMnwfsgs .
linalg.sgemm zrespM TmodesDMnwfsgs TmodesDMnwfsgs_WFS .GPUdevice=${GPUdevice}
iofits.saveFITS TmodesDMnwfsgs_WFS "!./${cfCMtmpdir}/TmodesDMnwfsgs_WFS.fits"
exit
EOF

cacao-cli << EOF
iofits.loadfits "${zrespm}" zrespM .
iofits.loadfits "./${cfCMtmpdir}/CMmDMn.fits" CMmDMn .
linalg.sgemm zrespM CMmDMn CMmDMn_WFS .GPUdevice=${GPUdevice}
iofits.saveFITS CMmDMn_WFS "!./${cfCMtmpdir}/CMmDMn_WFS.fits"
exit
EOF

cacao-cli << EOF
iofits.loadfits "${zrespm}" zrespM .
iofits.loadfits "./${cfCMtmpdir}/CMmDMnr.fits" CMmDMnr .
linalg.sgemm zrespM CMmDMnr CMmDMnr_WFS .GPUdevice=${GPUdevice}
iofits.saveFITS CMmDMnr_WFS "!./${cfCMtmpdir}/CMmDMnr_WFS.fits"
exit
EOF


# Check orthonormality in DM space (output)
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmWFSnr.fits" CMmWFSnr .
iofits.loadfits "./${cfCMtmpdir}/TmodesDMnWFSm.fits" TmodesDMnWFSm .
linalg.sgemm CMmWFSnr TmodesDMnWFSm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDMn_mxp.fits"
exit
EOF

fi




if [ ${TESTMODE} = 1 ]; then
# rotated basis now satisfies constraints
# check it is orthonormal

# OPTIONAL
#
# check new basis
# should be identity matrix
#
cacao-cli << EOF
iofits.loadfits "${WFSmask}" wfsmask .
iofits.loadfits "./${cfCMtmpdir}/CMmWFSnr.fits" CMmWFSnr .
@calc "CMmWFSnrm = CMmWFSnr * wfsmask"
linalg.sgemm CMmWFSnrm CMmWFSnrm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmWFSnr_mxp.fits"
exit
EOF

# OPTIONAL
#
# should be approximately diagonal
#
cacao-cli << EOF
iofits.loadfits "${DMmask}" dmmask .
iofits.loadfits "./${cfCMtmpdir}/CMmDMnr.fits" CMmDMnr .
@calc "CMmDMnrm = CMmDMnr * dmmask"
linalg.sgemm CMmDMnrm CMmDMnrm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmDMnr_mxp.fits"
exit
EOF
fi





# DM-normalize output modes
# RMS within dmmask should be = 1
#
# INPUT:
#   CMmDMnr   : rotated (new) basis, DM space
#   CMmWFSnr  : rotated (new) basis, WFS space
#
# OUTPUT:
#   conf/CMmodesDM/CMmodesDM_sf.fits
#   conf/CMmodesWFS/CMmodesWFS_sf.fits
#
cacao-cli << EOF
iofits.loadfits "./${cfCMtmpdir}/CMmWFSnr.fits" CMmWFSnr .
iofits.loadfits "./${cfCMtmpdir}/CMmDMnr.fits" CMmDMnr .
iofits.loadfits "${DMmask}" dmmask .
@calc 'mm = CMmDMnr * dmmask; mcnt = itot(dmmask); n2 = einsum("ijk,ijk->k", mm, mm); invrms = reshape(n2 > 0 ? sqrt(mcnt / n2) : 0.0, 1, 1, l.CMmDMnr.zsize); CMmDMnrn = CMmDMnr * invrms; CMmWFSnr = CMmWFSnr * invrms'
iofits.saveFITS CMmDMnrn "!conf/CMmodesDM/CMmodesDM_sf.fits"
iofits.saveFITS CMmWFSnr "!conf/CMmodesWFS/CMmodesWFS_sf.fits"
exit
EOF




if [ ${TESTMODE} = 1 ]; then
# OPTIONAL
#
# Test that output CM DM modes are unity RMS over dmmask
# diagonal value = number pix in dmmask
#
cacao-cli << EOF
iofits.loadfits "conf/CMmodesDM/CMmodesDM_sf.fits" CMmodesDM_sf .
iofits.loadfits "${DMmask}" dmmask .
@calc "CMmodesDM_sfm = CMmodesDM_sf * dmmask"
linalg.sgemm CMmodesDM_sfm CMmodesDM_sfm out .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS out "!./${cfCMtmpdir}/CMmodesDM_sf_xp.fits"
exit
EOF
fi





########################################################################
#
# SPATIAL EXTENSION
#
########################################################################



# Spatial extrapolation of DM modes
# use emodesDM, emodesDMe
#
# INPUT:
#   conf/CMmodesDM/CMmodesDM_sf.fits
#   emodesDM.fits
#   emodesDMe.fits
#
# OUTPUT:
#   conf/CMmodesDM/CMmodesDM_sfe.fits
#

cacao-cli << EOF
iofits.loadfits "conf/CMmodesDM/CMmodesDM_sf.fits" CMmodesDM_sf .
iofits.loadfits "./${cfCMtmpdir}/emodesDM.fits" emodesDM .
iofits.loadfits "./${cfCMtmpdir}/emodesDMe.fits" emodesDMe .
linalg.sgemm emodesDM CMmodesDM_sf mcoeff .GPUdevice=${GPUdevice} .transpA=1
iofits.saveFITS mcoeff "!./${cfCMtmpdir}/mcoeff.fits"
linalg.sgemm emodesDMe mcoeff CMmodesDM_sfme .GPUdevice=${GPUdevice} .transpA=0 .transpB=0
linalg.sgemm emodesDM mcoeff CMmodesDM_sfmem .GPUdevice=${GPUdevice} .transpA=0 .transpB=0
@calc "imres = CMmodesDM_sfme - CMmodesDM_sf"
iofits.saveFITS imres "!./${cfCMtmpdir}/imrese.fits"
iofits.loadfits "${DMmask}" dmmask .
@calc "imouto = CMmodesDM_sfme * (1.0 - dmmask)"
iofits.saveFITS imouto "!./${cfCMtmpdir}/imouto.fits"
exit
EOF

cacao-cli << EOF
iofits.loadfits "conf/CMmodesDM/CMmodesDM_sf.fits" CMmodesDM_sf .
iofits.loadfits "${DMmask}" dmmask .
iofits.loadfits "./${cfCMtmpdir}/imouto.fits" imouto .
@calc "CMmodesDM_sfm = CMmodesDM_sf * dmmask; imout = CMmodesDM_sfm + imouto"
iofits.saveFITS imout "!conf/CMmodesDM/CMmodesDM_sfe.fits"
exit
EOF


errexit=0


