#!/usr/bin/env bash

# This script uses milk-argparse
# See template milk-scriptexample in module milk_module_example for template and instructions

# script 1-line description
MSdescr="Take reference (from imWFS2)"

set +u
if [ -z ${CACAO_CONFWDIR+x} ]; then
	CACAO_CONFWDIR="conf"
fi
set -u


# Extended description
MSextdescr="Acquire WFS reference by averaging imWFS2"
source milk-script-std-config
source cacao-check-cacaovars


NBframe="1000"
MSopt+=( "n:nbframe:set_NBframe:nbframe[long]:set number of frames" )
function set_NBframe() {
	NBframe="$1"
}

source milk-argparse


# Checking stream
streamcheckOK="OK"
checkstream aol${CACAO_LOOPNUMBER}_imWFS2

if [ ${streamcheckOK} == "FAIL" ]; then
	echo "[$(tput setaf 1)$(tput bold) FAILED $(tput sgr0)] stream check failed"
	cacaomsglog "ERROR streamcheck"
	exit 1
fi

cacaomsglog "NBframe ${NBframe}"

_avefps="takeref_${CACAO_LOOPNUMBER}_$$"
_refshm="wfsref_${CACAO_LOOPNUMBER}_$$"
milk-shmimave "${_avefps}:fpsinit" "aol${CACAO_LOOPNUMBER}_imWFS1" "${_refshm}" "${NBframe}"
milk-fps-set "${_avefps}.out_shared" 1
milk-fps-set "${_avefps}.procinfo.triggersname" "aol${CACAO_LOOPNUMBER}_imWFS1"
milk-fps-set "${_avefps}.procinfo.triggermode" 3
milk-fps-set "${_avefps}.procinfo.loopcntMax" "${NBframe}"
milk-fps-set "${_avefps}.procinfo.enabled" ON
milk-shmimave "${_avefps}:run"
milk-fps-rm -f -x "${_avefps}"
milk-fpsexec-iofits-saveFITS _savefits:exec "${_refshm}" "!${CACAO_CONFWDIR}/wfsref.fits"
rm -f "${MILK_SHM_DIR}/${_refshm}.im.shm"


# LOGGING
# see cacaofuncs-log for conventions
#
source cacaofuncs-log

cacao-calib-logFITSfile wfsref

# Load to shmim
cacao-calib-loadFITSfile wfsref ${LOGFILEOUT}
cacao-calib-loadFITSfile wfsrefc ${LOGFILEOUT}





cacaomsglog "END"
