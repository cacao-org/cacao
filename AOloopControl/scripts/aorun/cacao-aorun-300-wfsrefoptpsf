#!/usr/bin/env bash

# This script uses milk-argparse
# See template milk-scriptexample in module milk_module_example for template and instructions

# script 1-line description
MSdescr="WFS reference optimization from PSF stream"

MSextdescr="Optimize WFS reference from PSF stream

Processes filesystem telemetry:
- PSF (CACAO_PSFSTREAM)
- WFS (CACAO_WFSSTREAM)
- DM (dmXXdisp)
These 3 streams must be recorded.

WFS telemetry location:
CACAO_TELEMETRY_LOGDIR/YYYYMMDD/

By default, timestart for the optimization is current time at script launch.
Can be overriden with ts option

"

source milk-script-std-config
source cacao-check-cacaovars

MSarg+=( "tspan:float:time span [s]" )
MSarg+=( "tint:float:integration time per sample" )


# UNIX time at start
TIMESTART=$(date +%s)
UTDAY=$(date -d @{$TIMESTART} +%Y%m%d)
#UTDAY=$(date -u '+%Y%m%d')
MSopt+=( "ts:tstart:set_timestart:TIMESTART[long]:set time start [unix tstamp]" )
function set_timestart() {
	TIMESTART="$1"
}


source milk-argparse
TSPAN="${inputMSargARRAY[0]}"
TINT="${inputMSargARRAY[1]}"

ACTIONOK=0



# Checking FPS
FPScheckOK="OK"

cacaomsglog "START"



streamWFSdir=${CACAO_TELEMETRY_LOGDIR}/${UTDAY}/${CACAO_WFSSTREAM}
streamPSFdir=${CACAO_TELEMETRY_LOGDIR}/${UTDAY}/${CACAO_PSFSTREAM}
streamDMdir=${CACAO_TELEMETRY_LOGDIR}/${UTDAY}/dm${CACAO_DMINDEX}disp


EXITSTATUS=0

checkDir ${streamWFSdir}
checkDir ${streamPSFdir}
checkDir ${streamDMdir}

if [ ${EXITSTATUS} = 1 ]; then
	echo "missing file - cannot proceed"
	exit 1
fi



# find last timing files in telemetry directories

echo "WFSdir = ${streamWFSdir}"

mkdir -p wdir_wfsrefoptpsf
cd wdir_wfsrefoptpsf

iter=0
NBiter=100

while [ ${iter} -ne ${NBiter} ] ; do
	echo ""
	echo "ITERATION ${iter}"
	let iter++ || :


set +e
# allow for error as timing files are either .dat or .txt, not both
ls ${streamWFSdir}/*.txt 2> /dev/null | tail -n 1
lastLogFileWFS=$( ls ${streamWFSdir}/*.txt 2> /dev/null | tail -n 1 )
echo "Last WFS file = ${lastLogFileWFS}"
cp $lastLogFileWFS _lastlogfileWFS

echo "PSFdir = ${streamPSFdir}"
ls ${streamPSFdir}/*.txt 2> /dev/null | tail -n 1
lastLogFilePSF=$( ls ${streamPSFdir}/*.txt 2> /dev/null | tail -n 1 )
echo "Last PSF file = ${lastLogFilePSF}"
cp $lastLogFilePSF _lastlogfilePSF
set -e


let "timeend = TIMESTART + TSPAN"

echo "TIME : ${TIMESTART} + ${TSPAN} -> ${timeend} ====================================="



# vOK is 1 if files need to be processed
# 0 if no input files to be processed
vOK="1"


lastLogTimeWFS=$( cat _lastlogfileWFS | tail -n 1 | awk '{print int($4)}' )
echo "WFS last log at $lastLogTimeWFS"

if [ "${lastLogTimeWFS}" -lt "${timeend}" ]; then
	vOK="0"
	echo "last WFS has not reached time end yet!"
	echo "${lastLogTimeWFS} < ${timeend}"
fi


lastLogTimePSF=$( cat _lastlogfilePSF | tail -n 1 | awk '{print int($4)}' )
echo "PSF last log at $lastLogTimePSF"

if [ "${lastLogTimePSF}" -lt "${timeend}" ]; then
	vOK="0"
	echo "last PSF has not reached time end yet!"
	echo "${lastLogTimePSF} < ${timeend}"
fi



if [ "$vOK" = "1" ]; then
echo "PROCESSING"



# Preprocessing

for fname in ${LOGDIR}/${UTDAY}/${SNAME}/*.timing; do
echo "FILE: $fname"
while IFS=" " read -r name findexstart ftimestart findexend ftimeend fnbframe ffrate
do
if (( $(echo "$ftimestart < $TEND" |bc -l) )); then
if (( $(echo "$ftimeend > $TSTART" |bc -l) )); then
  echo "    timestart = ${ftimestart}"
  echo "    timeend   = ${ftimeend}"
  echo "    FRAME   OK"

  fname1=${fname%.timing}
  fname2=${fname1##*/}
  echo " $fname -> $fname2"
  processcube $fname2
  echo ""
fi
fi
done < $fname
done

#cacao << EOF
#cacaopt.slogtsample .logdir "${CACAO_TELEMETRY_LOGDIR}"
#cacaopt.slogtsample .s0name ${CACAO_PSFSTREAM}
##cacaopt.slogtsample .s0tag ${S0TAG}
#cacaopt.slogtsample .s1name ${S1NAME}
#cacaopt.slogtsample .s1tag ${S1TAG}
#cacaopt.slogtsample .tstartnsec ${TSTARTNSEC}
#cacaopt.slogtsample .tendnsec ${TENDNSEC}
#cacaopt.slogtsample ${TSTARTSEC} ${TENDSEC} 0.02
#saveFITS ${S0NAME} "${S0NAME}.sync.fits"
#saveFITS ${S1NAME} "${S1NAME}.sync.fits"
#exitCLI
#EOF



# exit loop
iter=${NBiter}
fi


sleep 2.0

done



cd ..


cacaomsglog "END"
