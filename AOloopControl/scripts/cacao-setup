    tmux kill-session -t "${fpsCTRLtmuxname}" 2>/dev/null || :
    tmux new-session -d -s "${fpsCTRLtmuxname}" -c "${CACAO_LOOPRUNDIR_FULLPATH}" \
        "source ../fpstmuxenv 2>/dev/null || :; MILK_FPS_LOGFILE=\"../fpsCTRL.log\" milk-fpsCTRL" &>> "${LOGFILENAME}" || :
fi

