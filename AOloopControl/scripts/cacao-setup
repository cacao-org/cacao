# assemble fpsname from fpslist line
# output : fpsname
#
function getfpsname_fromline {
    IFS=' ' read -r -a array <<< "$1"

    for index in "${!array[@]}"; do

        if [ ${index} = 0 ]; then
            fpsname="${array[0]}"
        fi

        if [ ${index} -gt 1 ]; then
            fpsname="${fpsname}-${array[index]}"
        fi

    done
}


# List fpsnames
#
function cacaosetupLISTprocesses {
    echolog "LIST PROCESSES"
    pwd

    while IFS='' read -r line || [[ -n "$line" ]]; do
        getfpsname_fromline "${line}"
        printf "          %s\n" "${fpsname}"
    done < ${CACAO_LOOPRUNDIR}/fpslist.txt

    cd ${CURRDIR}
}






# send single FPS control line natively via milk-fps-* tools (no FIFO)
function sendFPScmd {
    local line="$1"
    line="${line#"${line%%[![:space:]]*}"}"
    if [ -z "${line}" ] || [ "${line::1}" = "#" ]; then
        return 0
    fi
    echolog "FPS CMD: ${line}"
    local IFS=$' \t\n'
    local cmd="" arg1="" arg2=""
    read -r cmd arg1 arg2 <<< "${line}"
    case "${cmd}" in
        setval)
            milk-fps-set "${arg1}" "${arg2}"
            ;;
        confstart)
            milk-fps-confstart "${arg1}"
            ;;
        confstop)
            milk-fps-confstop "${arg1}"
            ;;
        confupdate|confwupdate|confstep)
            milk-fps-confstep "${arg1}"
            ;;
        runstart)
            milk-fps-runstart "${arg1}"
            ;;
        runstop)
            milk-fps-runstop "${arg1}"
            ;;
        fpsrm)
            milk-fps-rm -f -x "${arg1}"
            ;;
        waitonrunON|waitonrunOFF|waitonconfON|waitonconfOFF|setqindex|setqprio|queueprio|logsymlink|exit)
            :
            ;;
        *)
            echolog "WARNING: unknown FPS command '${cmd}': ${line}"
            ;;
    esac
}


# send command to all FPSs
# example:
# allFPScmd confstart
#
# also feeds fps.conf/fpssetup.cacaosetup-<cmd>.<fpsname>.conf if it exists
#
function allFPScmd {
    echolog "SENDING CMD $1 TO ALL CONF PROCESSES"
    echo "running command $1 on all FPSs"

    [ -f "${CACAO_LOOPRUNDIR_FULLPATH}/fpslist.txt" ] || return 0

    while IFS='' read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        if [ -z "${line}" ] || [ "${line::1}" = "#" ] || [ "${line::1}" = "+" ]; then
            continue
        fi
        getfpsname_fromline "${line}"
        echolog "command $1 for FPS ${fpsname}"
        sendFPScmd "$1 ${fpsname}" || true

        # if there is a taskfile associated with command, load it
        #
        taskflist="${CACAO_LOOPRUNDIR_FULLPATH}/fps.conf/fpssetup.cacaosetup-$1.${fpsname}.conf"
        echolog "FILE : ${taskflist}"
        if [ -f "${taskflist}" ]; then
            echolog "FILE ${taskflist} EXISTS"
            while IFS='' read -r taskline || [[ -n "${taskline}" ]]; do
                echolog "${taskline}"
                sendFPScmd "${taskline}" || true
            done < "${taskflist}"
        else
            echolog "FILE ${taskflist} DOES NOT EXIST - NOTHING TO DO"
        fi
    done < "${CACAO_LOOPRUNDIR_FULLPATH}/fpslist.txt"
}




# clear FPSs, tmux sessions and log files
# Requires RUN processes to be OFF
#
function cacaosetupCLEAR
{
    echo "CLEARING cacao-setup"
    echolog "CLEARING"
    cd "${CURRDIR}"

    echo "CACAO_LOOPRUNDIR_FULLPATH : ${CACAO_LOOPRUNDIR_FULLPATH}"

    # turn off RUN processes
    allFPScmd runstop

    # turn off CONF processes
    allFPScmd confstop

    # remove FPSs and unit dirs
    allFPScmd fpsrm

    # cleanup legacy log files if present
    if [ -f "${CACAO_LOOPRUNDIR_FULLPATH}/fpslist.txt" ]; then
        while IFS='' read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            if [ -z "${line}" ] || [ "${line::1}" = "#" ] || [ "${line::1}" = "+" ]; then
                continue
            fi
            getfpsname_fromline "${line}"
            find "${MILK_SHM_DIR}" -type l -name "fpslog.*-${fpsname}" -exec sh -c 'rm -f "$(readlink "$1")"' _ {} \; 2>/dev/null || true
            find "${MILK_SHM_DIR}" -type l -name "fpslog.*-${fpsname}" -delete 2>/dev/null || true
        done < "${CACAO_LOOPRUNDIR_FULLPATH}/fpslist.txt"
    fi

    # kill interactive fpsCTRL tmux session if running
    tmux kill-session -t "${fpsCTRLtmuxname}" 2>/dev/null || true

    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmC.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmRM.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmO.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmdisp.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmZP*.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_dmzpo.im.shm &>> ${LOGFILENAME}
    rm -f ${MILK_SHM_DIR}/aol${LOOPNUMBER}_wfsim.im.shm &>> ${LOGFILENAME}

    # remove fpsCTRL log and its sym link if present
    file="${MILK_SHM_DIR}/fpslog.${CACAO_LOOPNAME}"
    if [ -L "$file" ]; then
        rm -f "$(readlink "$file")" 2>/dev/null || true
    fi
    rm -f "$file" 2>/dev/null || true

    cd "${CURRDIR}"
}





# Combine fpssetup files and apply natively via sendFPScmd
#
function fpssetparamconf {
    echolog "Applying FPS setup parameters natively"
    echo "SETTING PARAMETERS via milk-fps-set"

    rm -f fpssetuptmp.tmp fpssetup.setval.combined.conf
    if [ -f "${CURRDIR}/${fpsSETPARAMCONFfile}" ]; then
        sed "s/LOOPNUMBER/${LOOPNUMBER}/g" "${CURRDIR}/${fpsSETPARAMCONFfile}" \
            | sed "s/DMINDEX/${CACAO_DMINDEX}/g" \
            | sed "s/DMSIMINDEX/${CACAO_DMSIMINDEX:-00}/g" > fpssetuptmp.tmp
    fi

    touch fpssetuptmp.tmp
    touch "${CURRDIR}/fpssetup.setval.conf"

    cat "${CURRDIR}/fpssetup.setval.conf" fpssetuptmp.tmp > fpssetup.setval.combined.conf
    rm -f "${CURRDIR}/fpssetup.setval.conf"

    while IFS='' read -r line || [[ -n "$line" ]]; do
        sendFPScmd "${line}"
    done < fpssetup.setval.combined.conf
}












