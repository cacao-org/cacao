# SETUP ALL FPSs natively via <fpsexec> -n <fpsname> fpsinit
#
export FPS_KEYWORDARRAY=":cacao-setup:${CACAO_LOOPNAME}:aol${CACAO_LOOPNUMBER}_:"
rm -f fpsinit.newFPS.log
touch fpsinit.newFPS.log

while IFS='' read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    if [ -z "${line}" ] || [ "${line::1}" = "#" ] || [ "${line::1}" = "+" ]; then
        continue
    fi
    read -r -a arr <<< "${line}"
    fcall="${arr[1]:-}"
    [ -n "${fcall}" ] || continue
    getfpsname_fromline "${line}"
    if [ ! -f "${MILK_SHM_DIR}/${fpsname}.fps.shm" ]; then
        echo "${fpsname}" >> fpsinit.newFPS.log
    fi
    echolog "fpsinit ${fpsname} (${fcall})"
    "${fcall}" -n "${fpsname}" fpsinit &>> "${LOGFILENAME}"
done < "${CACAO_LOOPRUNDIR_FULLPATH}/fpslist.txt"

# Launch interactive milk-fpsCTRL TUI in tmux (no -s / -f flags)
