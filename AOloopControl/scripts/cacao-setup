  # Apply user parameter overrides after default confstart settings
  fpssetparamconf
else
  fpsnewfname="fpsinit.newFPS.log"
  echo "READING FILE ${fpsnewfname}"

  if [ -f "${fpsnewfname}" ]; then
    while read -r LINE
    do
      [ -n "${LINE}" ] || continue
      fpsname="${LINE}"
      printf "NEW FPS ENTRY = %s\n" "${fpsname}"
      sendFPScmd "confstart ${fpsname}" || true

      taskflist="${CACAO_LOOPRUNDIR_FULLPATH}/fps.conf/fpssetup.cacaosetup-confstart.${fpsname}.conf"
      echo "TASKFILELIST : ${taskflist}"
      if [ -f "${taskflist}" ]; then
        while IFS='' read -r taskline || [[ -n "${taskline}" ]]; do
          echolog "${taskline}"
          sendFPScmd "${taskline}" || true
        done < "${taskflist}"
      else
        echo "FILE ${taskflist} DOES NOT EXIST - NOTHING TO DO"
      fi
    done < "$fpsnewfname"
  fi
fi




# ===================================================================================
# Startup sequence: establish links
# ===================================================================================
