#!/usr/bin/env bash

# This script uses milk-argparse
# See template milk-scriptexample in module milk_module_example for template and instructions

# script 1-line description
MSdescr="Find Photonic Lantern Spots"

MSextdescr="The photonic lantern should be illuminated for the script to run"

source milk-script-std-config
source cacao-check-cacaovars

MSarg+=( "nbave:integer:number of frames averaged" )

source milk-argparse

NBAVE="${inputMSargARRAY[0]}"



# average #NBAVE frames, write result to conf/wfsimave.fits

_avefps="findspots_$$"
_avestream="_imave_$$"
milk-shmimave "${_avefps}:fpsinit" "aol${CACAO_LOOPNUMBER}_wfsim" "${_avestream}" "${NBAVE}"
milk-fps-set "${_avefps}.procinfo.triggersname" "aol${CACAO_LOOPNUMBER}_wfsim"
milk-fps-set "${_avefps}.procinfo.triggermode" 3
milk-fps-set "${_avefps}.procinfo.loopcntMax" "${NBAVE}"
milk-shmimave "${_avefps}:run"
milk-fps-rm -f -x "${_avefps}"

cacao-cli << EOF
mem.readshmim ${_avestream}
mem.readshmim aol${CACAO_LOOPNUMBER}_wfsdark
@calc "imaved = s.${_avestream} - s.aol${CACAO_LOOPNUMBER}_wfsdark"
iofits.saveFITS imaved "!conf/wfsimave.fits"
exit
EOF
rm -f "${MILK_SHM_DIR}/${_avestream}.im.shm"

spotsize="10"
spotexcldist="30"
nbspots="19"

cacao-cli << EOF
iofits.loadfits "conf/wfsimave.fits" imave .
cacaoio.findspots imave ${spotsize} ${spotexcldist} ${nbspots} spotmap
iofits.saveFITS spotmap "!conf/spotmap.fits"
exit
EOF


milk-FITS2shm _loadfits:exec "conf/spotmap.fits" "@S:aol${CACAO_LOOPNUMBER}_wfsmapping"
