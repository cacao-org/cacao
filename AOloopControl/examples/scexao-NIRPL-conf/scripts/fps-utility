#!/usr/bin/env bash

# utility functions for configuring custom functions in fpsCTRL
# run in rootdir

source cacao-check-cacaovars

function setupfps {
	(
	cd ${CACAO_LOOPRUNDIR} || return 1
	local fn="$1"
	local fpsname="${fn}-${CACAO_LOOPNUMBER}"
	local execbin="cacao-fpsexec-cacaoiot-${fn//_/}"
	echo "CONFIGURING: ${fn}"
	"${execbin}" -n "${fpsname}" fpsinit
	echo "STARTING CONF PROCESS"
	sendFPScmd "confstart ${fpsname}"
	)
}
