#!/usr/bin/env bash

# create XY astrogrid pattern
cacao-astrogrid-mkgrid -b3 0



milk-fps-set DMch2disp-00.astrogrid.nbframe 1
milk-fps-set DMch2disp-00.astrogrid.delay 0
milk-fps-set DMch2disp-00.astrogrid.mult 0.025
milk-fps-set DMch2disp-00.astrogrid.mode ON


# log information
dologext "ASTROGID ON  amp = 0.025 um  speed = 1x  11 l/d diag" &


scxkw-setter set X_GRDST XYdiag 0
scxkw-setter set X_GRDAMP 0.025
scxkw-setter set X_GRDSEP 11
scxkw-setter set X_GRDMOD 2000
