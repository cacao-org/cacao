#!/bin/bash

#########################################################
# apply a calibration and reload CACAO
#########################################################

echo 'Applying Calibration' $1

milk-fps-runstop mvalC2dm-2
milk-fps-confstop mvalC2dm-2
milk-fps-runstop mfilt-2
milk-fps-confstop mfilt-2
milk-fps-runstop wfs2cmodeval-2
milk-fps-confstop wfs2cmodeval-2

sleep 1
milk-fps-runstop mvalC2dm-2
milk-fps-runstop mfilt-2
milk-fps-runstop wfs2cmodeval-2

sleep 1

cmd='cacao-calib-apply '$1
$cmd

sleep 1
milk-fps-confstart wfs2cmodeval-2
sleep 1
milk-fps-runstart wfs2cmodeval-2
sleep 1
milk-fps-confstart mfilt-2
sleep 1
milk-fps-runstart mfilt-2
sleep 1
milk-fps-confstart mvalC2dm-2
sleep 1
milk-fps-runstart mvalC2dm-2
