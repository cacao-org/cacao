#!/usr/bin/env bash

act1Dval=$1
act2Dim=$2

# Remap to 2D, loop
#
milk-FITS2shm _loadfits:exec "data/mapping.fits" "@S:_map_${act2Dim}"
milk-fpsexec-milk-calc -loops -t "${act1Dval}" -e "s.${act2Dim} = pixremap(s.${act1Dval}, s._map_${act2Dim})" "remap_${act2Dim}:fpsinit"
milk-fps-set "remap_${act2Dim}.procinfo.triggermode" 4
milk-fps-set "remap_${act2Dim}.procinfo.triggerdelay" 0.02
milk-fps-set "remap_${act2Dim}.procinfo.triggersname" "${act1Dval}"
exec milk-fpsexec-milk-calc "remap_${act2Dim}:run"
