# SPDX-License-Identifier: LGPL-3.0-or-later

set -euo pipefail

case "${1-}" in
    -h1|--help-oneline)
        echo "calibrate pyramid WFS 4-pupil geometry, packed zone masks, and baseline flux ratios"
        exit 0
        ;;
    -h2|--help-description)
        echo "Detect or fit 4-pupil geometry (pyWFSgridmatch / pyrwfs_detect), build packed @calc zone masks, and measure flat-WF baseline flux partitioning."
        exit 0
        ;;
    -h|--help|-hm|--help-mono)
        cat <<'EOF'
Usage: cacao-pyrwfs-calib <ref> [prefix] [zrespM] [dmx] [dmy] [options...]
   or: cacao-pyrwfs-calib .ref=<stream> [.prefix=aol0_pyr] [.outdir=<dir>] ...

Calibrate pyramid WFS geometry and packed zone masks via pyrwfs.calib.
EOF
        command -v milk-cli >/dev/null 2>&1 && MILK_QUIET=1 milk-cli -q -c "pyrwfs.calib -h" || true
        exit 0
        ;;
esac

_q=""
printf -v _q '%q ' "$@"
MILK_QUIET=1 exec milk-cli -q -e -o -c "pyrwfs.calib ${_q}"
